# =============================================================================
# Quick Chat — environment variables
# Copy to .env.local for development. NEVER commit real values.
# Variables prefixed NEXT_PUBLIC_ are sent to the browser: never put secrets there.
# =============================================================================

# --- App (required) -----------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Quick Chat

# --- Supabase (REQUIRED) -------------------------------------------------------
# Project Settings -> API. The service role key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Private bucket used when Cloudflare R2 is not configured.
SUPABASE_STORAGE_BUCKET=media

# --- Cloudflare R2 (optional; recommended for media at scale) -------------------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
# Optional custom domain for the bucket (objects are still served via signed URLs).
CLOUDFLARE_R2_PUBLIC_URL=

# --- LiveKit (optional; required for audio/video calls) -------------------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Firebase Cloud Messaging (optional; browser push notifications) -----------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Web Push certificate (Project settings -> Cloud Messaging -> Web configuration).
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
# Service account JSON (raw JSON or base64-encoded). Server-only.
FIREBASE_SERVICE_ACCOUNT=

# --- Setup tokens (local only; delete after setup and revoke in dashboards) ---
SUPABASE_ACCESS_TOKEN=
VERCEL_TOKEN=


# --- Resend (optional; security alert emails) -----------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=Quick Chat <noreply@your-domain>
# --- Redis (optional; shared rate limiting across serverless instances) ---------
REDIS_URL=

# --- Background jobs (required in production for media cleanup) -----------------
# Random string; Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# --- GIPHY (optional) ---
GIPHY_API_KEY=

# --- Security -------------------------------------------------------------------
# Require admins to verify with TOTP two-factor auth (aal2) to use /admin.
ADMIN_REQUIRE_MFA=true

# Razorpay — Quick Chat Premium. Use TEST keys (rzp_test_...) until live payments are approved.
# Webhook: https://<your-domain>/api/premium/webhook with events payment.*, order.paid,
# subscription.*, refund.* and a webhook secret.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
